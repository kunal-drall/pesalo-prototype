# Pesalo mobile env. Copy to mobile/.env.local for local dev, or set as
# EAS Build secrets for native builds.

# Stellar
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# OpenZeppelin Stellar Channels (replaces Launchtube). Get a testnet API key at
# https://channels.openzeppelin.com/testnet/gen
EXPO_PUBLIC_CHANNELS_BASE_URL=https://channels.openzeppelin.com/testnet
EXPO_PUBLIC_CHANNELS_API_KEY=

# Backend
EXPO_PUBLIC_API_URL=https://api.pesalo.fun/v1

# Contract addresses (populated from contracts/.deployed.env after deploy).
EXPO_PUBLIC_ROUTER_CONTRACT_ID=
EXPO_PUBLIC_USDC_MARKET_CONTRACT_ID=
EXPO_PUBLIC_EURC_MARKET_CONTRACT_ID=
EXPO_PUBLIC_USDC_SY_CONTRACT_ID=
EXPO_PUBLIC_EURC_SY_CONTRACT_ID=
EXPO_PUBLIC_XLM_SY_CONTRACT_ID=
EXPO_PUBLIC_USDC_SPLITTER_CONTRACT_ID=
EXPO_PUBLIC_EURC_SPLITTER_CONTRACT_ID=
EXPO_PUBLIC_USDC_ASSET_CONTRACT_ID=
EXPO_PUBLIC_EURC_ASSET_CONTRACT_ID=

# Passkey factory + smart wallet WASM hash (set after deploying kalepail's
# webauthn-factory on testnet).
EXPO_PUBLIC_PASSKEY_FACTORY_ID=
EXPO_PUBLIC_PASSKEY_WALLET_HASH=

# Sentry (optional, configured in a later step)
EXPO_PUBLIC_SENTRY_DSN=
