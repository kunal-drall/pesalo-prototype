{
  "expo": {
    "name": "Pesalo",
    "slug": "pesalo",
    "scheme": "pesalo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.pesalo.Pesalo",
      "associatedDomains": [
        "webcredentials:pesalo.app"
      ],
      "supportsTablet": false
    },
    "android": {
      "package": "app.pesalo",
      "adaptiveIcon": {
        "backgroundColor": "#080B11"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
