{
  "expo": {
    "name": "Pesalo",
    "slug": "pesalo",
    "scheme": "pesalo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fun.pesalo.Pesalo",
      "associatedDomains": [
        "webcredentials:pesalo.fun"
      ],
      "supportsTablet": false
    },
    "android": {
      "package": "fun.pesalo",
      "adaptiveIcon": {
        "backgroundColor": "#080B11"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03f27233-d502-418c-8ea4-0a5e054e63e7"
      }
    },
    "owner": "twenty9projects-lab"
  }
}
