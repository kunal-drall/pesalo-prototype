# Pesalo backend configuration. Copy to .env (gitignored) and fill in.

# HTTP server
PORT=3001

# Stellar network endpoints (testnet defaults)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Reflector oracle contract id (https://reflector.network/)
REFLECTOR_CONTRACT_ID=

# Pesalo contract addresses (sourced from contracts/.deployed.env)
ROUTER_CONTRACT_ID=
USDC_MARKET_CONTRACT_ID=
EURC_MARKET_CONTRACT_ID=
USDC_SPLITTER_CONTRACT_ID=
EURC_SPLITTER_CONTRACT_ID=
USDC_SY_CONTRACT_ID=
EURC_SY_CONTRACT_ID=
XLM_SY_CONTRACT_ID=
USDC_ASSET_CONTRACT_ID=
EURC_ASSET_CONTRACT_ID=

# Observability
SENTRY_DSN=

# Cache / polling
CACHE_TTL_MS=30000
RATE_REFRESH_INTERVAL_SEC=60
PRICE_REFRESH_INTERVAL_SEC=15
EVENT_REFRESH_INTERVAL_SEC=30
