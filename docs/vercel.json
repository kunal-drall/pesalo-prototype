{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && rm -rf public && mkdir -p public/docs && cp -R build/. public/docs/",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/docs", "permanent": false }
  ]
}
